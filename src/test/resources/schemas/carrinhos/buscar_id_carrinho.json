{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "produtos": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "idProduto": {
              "type": "string"
            },
            "quantidade": {
              "type": "string"
            },
            "precoUnitario": {
              "type": "integer"
            }
          },
          "required": [
            "idProduto",
            "quantidade",
            "precoUnitario"
          ]
        }
      ]
    },
    "precoTotal": {
      "type": "integer"
    },
    "quantidadeTotal": {
      "type": "string"
    },
    "idUsuario": {
      "type": "string"
    },
    "_id": {
      "type": "string"
    }
  },
  "required": [
    "produtos",
    "precoTotal",
    "quantidadeTotal",
    "idUsuario",
    "_id"
  ]
}