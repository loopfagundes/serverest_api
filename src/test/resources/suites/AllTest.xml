    </test>
    <test name="Teste de API - Carrinhos">
        <classes>
            <class name="dev.serverest.testcases.contrato.CarrinhoTestCase">
                <methods>
                    <include name="buscarTodosCarrinhos200"></include>
                    <include name="cadastrarUmCarrinho201"></include>
                    <include name="buscarPorIDDoCarrinhos200"></include>
                    <include name="concluirACompraDoCarrinho200"></include>
                </methods>
